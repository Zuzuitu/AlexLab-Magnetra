{
  "name": "alexlab-magnetra",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "index.alexlab.media",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "FLUD_RELAY",
      "service": "flud-remote-relay"
    }
  ],
  "ratelimits": [
    {
      "name": "MAGNETRA_API_RATE",
      "namespace_id": "2026102507",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ]
}
