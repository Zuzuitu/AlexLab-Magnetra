[Unit]
Description=Magnetra independent EZTV Cloudflare Tunnel (optional)
After=network-online.target magnetra-eztv.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/magnetra-eztv/tunnel-token
Environment=TUNNEL_TOKEN_FILE=%d/tunnel-token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
CPUQuota=20%
TasksMax=24
UMask=0077

[Install]
WantedBy=multi-user.target
